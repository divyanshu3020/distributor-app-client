# Supabase Public Client Credentials (Safe for client bundle with RLS enabled)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# App Environment
APP_ENV=development

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FCM_VAPID_KEY=your-web-push-vapid-key-if-using-pwa

# ==============================================================================
# DEVELOPER REMOTE KILL-SWITCH INSTRUCTIONS (CLIENT ACCESS CONTROL)
# ==============================================================================
# 1. To LOCK the app on all client phones immediately:
#    In PowerShell run: .\scripts\lock-app.ps1
#
# 2. To UNLOCK the app (restore access after payment):
#    In PowerShell run: .\scripts\unlock-app.ps1
#
# 3. From Mobile/Browser (via Supabase SQL Editor):
#    - Lock:   INSERT INTO public.announcements (title, message, is_published) VALUES ('APP_LICENSE_LOCK', 'Trial ended. Contact developer.', true);
#    - Unlock: DELETE FROM public.announcements WHERE title = 'APP_LICENSE_LOCK';
#
# Note: App also has an automatic offline trial expiry on November 30, 2026.
# ==============================================================================
